# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Email (Resend). Leave RESEND_API_KEY empty to print emails to the server log instead of sending them.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend. For a quick test use: Harbour Ride <onboarding@resend.dev>
# (Resend only delivers onboarding@resend.dev mail to your own Resend account's address.)
BOOKING_FROM=Harbour Ride <bookings@example.com>
# Where new bookings go (dispatch).
BOOKING_TO=dispatch@example.com

# Signs fare quotes so they can't be edited in the browser. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUOTE_SECRET=

# Business details shown on the page and in emails.
NEXT_PUBLIC_BUSINESS_PHONE=02 0000 0000
NEXT_PUBLIC_SITE_URL=https://harbour-ride.vercel.app

# Tariff and booking rules.
NEXT_PUBLIC_FLAG_FALL=3.60
NEXT_PUBLIC_MIN_LEAD_MINUTES=30

# Optional: your own or a paid geocoder/router/map style instead of the public demo servers.
# PHOTON_URL=https://photon.komoot.io
# OSRM_URL=https://router.project-osrm.org
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
GEOCODER_USER_AGENT=HarbourRide/1.0 (you@example.com)
